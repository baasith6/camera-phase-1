# Production .env template for Azure MVP VM (/opt/onevo/.env)
# Copy to the VM and fill secrets. Do NOT commit real values.

# ---- Azure deploy (set by GitHub Actions or manually) ----
ACR_LOGIN_SERVER=onevoacr.azurecr.io
ACR_USERNAME=
ACR_PASSWORD=
ONEVO_BACKEND_IMAGE=onevoacrmvp.azurecr.io/onevo-backend:latest
ONEVO_DASHBOARD_IMAGE=onevoacrmvp.azurecr.io/onevo-dashboard:latest
ONEVO_CLOUD_AI_IMAGE=onevoacrmvp.azurecr.io/onevo-cloud-ai:latest

# ---- PostgreSQL ----
POSTGRES_USER=onevo
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=onevo

# ---- Redis ----
REDIS_CONNECTION=redis:6379

# ---- MinIO ----
MINIO_ROOT_USER=onevo_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
S3_ENDPOINT=http://minio:9000
# MVP without TLS/DNS: use VM public IP + MinIO port (NSG must allow 9000 from shop PCs).
S3_PUBLIC_ENDPOINT=http://20.193.69.220:9000
# With TLS + nginx /storage proxy (future): S3_PUBLIC_ENDPOINT=https://api.yourdomain.example/storage
S3_BUCKET=onevo-clips
S3_ACCESS_KEY=onevo_minio
S3_SECRET_KEY=CHANGE_ME_STRONG
S3_REGION=us-east-1

# ---- Backend ----
ASPNETCORE_ENVIRONMENT=Production
BACKEND_URL=https://api.yourdomain.example
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_ISSUER=onevo
JWT_AUDIENCE=onevo
SEED_ADMIN_EMAIL=admin@onevo.local
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG
CONNECTOR_BOOTSTRAP_KEY=CHANGE_ME_RANDOM
CLOUD_AI_SERVICE_KEY=CHANGE_ME_RANDOM_CLOUD_AI
CONNECTOR_INSTALLER_VERSION=1.0.0

# ---- Pilot ----
ALERT_VISIBILITY_MODE=ManagerOnly

# ---- Email (Gmail SMTP) ----
SMTP_ENABLE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=alerts@yourcompany.com
DASHBOARD_BASE_URL=https://app.yourdomain.example

# ---- Cloud AI ----
CLOUD_AI_BACKEND_URL=http://backend:8080
CLOUD_AI_MODEL_BACKEND=yoloe
CLOUD_AI_MODEL=yoloe-11s-seg.pt
CLOUD_AI_DEVICE=cuda
# Optional YOLOE prompt->cue overrides (comma-separated prompt=cue pairs).
# Leave blank to use built-in defaults in cloud-ai/app/detector.py (12 retail prompts;
# jacket phrases map to concealment, not open_bag). See docs/AZURE_MVP_DEPLOY.md.
# CLOUD_AI_YOLOE_PROMPTS=person=person,open bag=open_bag,person hiding item inside jacket=concealment

# ---- CORS (dashboard origin) ----
CORS_ORIGINS=https://app.yourdomain.example

# ---- Public URLs (installer bake + smoke tests) ----
BACKEND_PUBLIC_URL=https://api.yourdomain.example

# ---- Swagger off in prod ----
ENABLE_SWAGGER=false
